rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      return userDoc(uid).data.role;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParent(uid) {
      return isOwner(uid) && userRole(uid) == 'parent';
    }

    function isStudent(uid) {
      return isOwner(uid) && userRole(uid) == 'student';
    }

    function isLinkedStudentForParent(studentUid) {
      return isParent(request.auth.uid)
             && studentUid in userDoc(request.auth.uid).data.linkedStudentIds;
    }

    function isOwnStudentCodeData(data) {
      return isSignedIn() && data.studentId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isLinkedStudentForParent(uid);
      allow update, delete: if isOwner(uid);
      allow create: if isOwner(uid);
    }

    // Student-parent link codes
    // student_link_codes/{code}
    match /student_link_codes/{code} {
      // Signed-in users can read a specific code document to perform linking.
      allow read: if isSignedIn();

      // Only student owner can create/update/deactivate their own codes.
      allow create: if isOwnStudentCodeData(request.resource.data);
      allow update: if isOwnStudentCodeData(resource.data)
                    && isOwnStudentCodeData(request.resource.data);
      allow delete: if isOwnStudentCodeData(resource.data);
    }

    // Student weekly teacher notes
    // student_program_notes/{studentId}/days/{dayKey}
    match /student_program_notes/{studentId}/days/{dayKey} {
      // Student reads only own notes.
      allow read: if isStudent(request.auth.uid) && request.auth.uid == studentId;

      // Parent reads note if studentId exists in parent's linkedStudentIds.
      allow read: if isParent(request.auth.uid)
                  && studentId in userDoc(request.auth.uid).data.linkedStudentIds;

      // Future teacher role write rule can be added here.
      // Temporary: deny writes from mobile until teacher auth/role is added.
      allow write: if false;
    }
  }
}
